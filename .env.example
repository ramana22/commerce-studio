# =============================================================================
# Sugar Store — Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (docker-compose defaults shown)
DATABASE_URL=postgresql://sugar:sugar@localhost:5432/sugar_store

# ── Cache / Queues ────────────────────────────────────────────────────────────
# Redis connection string (docker-compose defaults shown)
REDIS_URL=redis://localhost:6379

# ── Medusa Backend ────────────────────────────────────────────────────────────
# URL where the Medusa API is reachable (used by storefront and scripts)
MEDUSA_BACKEND_URL=http://localhost:9000
# Browser-visible backend URL (defaults to MEDUSA_BACKEND_URL when unset)
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Publishable API key — printed by `pnpm backend:seed`; paste the value here
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_

# Default checkout country (ISO code) used for the storefront region
NEXT_PUBLIC_DEFAULT_COUNTRY=us

# Admin credentials (used by the catalog-import script)
MEDUSA_ADMIN_EMAIL=admin@sugarcosmetics.com
MEDUSA_ADMIN_PASSWORD=changeme

# CORS origins (comma-separated)
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:9000

# Secrets — generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string
COOKIE_SECRET=replace-with-a-long-random-string

# ── Storefront revalidation (Medusa product.* subscriber → Next.js ISR) ───────
# URL where the storefront is reachable from the backend. When set, the
# product.* subscriber pings the storefront to purge its catalog cache.
STOREFRONT_URL=http://localhost:3000
# Shared secret guarding the storefront /api/revalidate route. Optional in dev;
# set the same value here and in the storefront environment for production.
REVALIDATE_SECRET=

# ── Sanity CMS ────────────────────────────────────────────────────────────────
SANITY_STUDIO_PROJECT_ID=your-sanity-project-id
SANITY_STUDIO_DATASET=production
SANITY_API_TOKEN=sk...
# Public vars (available in Next.js browser bundle)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-sanity-project-id
NEXT_PUBLIC_SANITY_DATASET=production

# ── Cloudflare R2 (media storage) ─────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=sugar-store-media
# Public base URL for the R2 bucket (set up a custom domain in R2 settings)
CLOUDFLARE_R2_PUBLIC_URL=https://media.sugarcosmetics.com
# Browser-visible media base URL — storefront prefixes catalog image paths with this
NEXT_PUBLIC_MEDIA_BASE_URL=https://media.sugarcosmetics.com

# ── Payments ──────────────────────────────────────────────────────────────────
# Auto-capture the payment when an order is placed so the order reaches a paid
# state. Set to false to leave payments authorized (e.g. capture via webhook).
PAYMENT_AUTO_CAPTURE=true

# ── Payment Provider — Square (Phase 9) ───────────────────────────────────────
# When ACCESS_TOKEN + APPLICATION_ID + LOCATION_ID are set, the backend registers
# the Square payment provider and the storefront drives the Square card form.
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
# 'sandbox' (default) or 'production'
SQUARE_ENVIRONMENT=sandbox
# Optional — set if you enable Square webhooks (signature verification)
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Public values for the storefront Web Payments SDK
NEXT_PUBLIC_SQUARE_APPLICATION_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
NEXT_PUBLIC_SQUARE_ENVIRONMENT=sandbox

# ── Email / Transactional ─────────────────────────────────────────────────────
SENDGRID_API_KEY=
EMAIL_FROM=noreply@sugarcosmetics.com

# ── Monitoring — Sentry (Phase 9) ─────────────────────────────────────────────
# Server-side DSN (backend + storefront server runtime). Leave empty to disable.
SENTRY_DSN=
# Storefront public DSN (used by the server instrumentation hook)
NEXT_PUBLIC_SENTRY_DSN=
# Trace sample rate (0–1)
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Analytics / RUM (Phase 10) ────────────────────────────────────────────────
# Optional JSON sink the storefront forwards funnel + Web Vitals events to
# (PostHog capture endpoint, a collector, a webhook…). When unset, events are
# logged server-side so the funnel stays observable in dev.
ANALYTICS_WEBHOOK_URL=
