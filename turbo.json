{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "NODE_EXTRA_CA_CERTS",
    "SSL_CERT_FILE",
    "REQUESTS_CA_BUNDLE",
    "HTTP_PROXY",
    "HTTPS_PROXY",
    "NO_PROXY",
    "http_proxy",
    "https_proxy",
    "no_proxy",
    "DATABASE_URL",
    "REDIS_URL",
    "JWT_SECRET",
    "COOKIE_SECRET",
    "STORE_CORS",
    "ADMIN_CORS",
    "AUTH_CORS",
    "MEDUSA_ADMIN_EMAIL",
    "MEDUSA_ADMIN_PASSWORD",
    "CLOUDFLARE_*",
    "SENDGRID_API_KEY",
    "EMAIL_FROM",
    "STOREFRONT_URL",
    "REVALIDATE_SECRET",
    "PAYMENT_AUTO_CAPTURE",
    "SQUARE_ACCESS_TOKEN",
    "SQUARE_APPLICATION_ID",
    "SQUARE_LOCATION_ID",
    "SQUARE_ENVIRONMENT",
    "SQUARE_WEBHOOK_SIGNATURE_KEY",
    "MEILISEARCH_HOST",
    "MEILISEARCH_MASTER_KEY",
    "MEILISEARCH_SEARCH_KEY",
    "MEILI_ENV"
  ],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "NEXT_PUBLIC_*",
        "MEDUSA_BACKEND_URL",
        "SANITY_*",
        "SENTRY_DSN",
        "SENTRY_TRACES_SAMPLE_RATE"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", ".output/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "format": {
      "cache": false,
      "outputs": []
    }
  }
}
