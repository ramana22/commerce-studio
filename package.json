{
  "name": "sugar-store",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,md,css}\" --ignore-path .gitignore",
    "catalog:sample": "pnpm --filter @sugar-store/catalog-import create-sample",
    "catalog:validate": "pnpm --filter @sugar-store/catalog-import validate",
    "catalog:transform": "pnpm --filter @sugar-store/catalog-import transform",
    "catalog:import": "pnpm --filter @sugar-store/catalog-import import",
    "backend:seed": "pnpm --filter @sugar-store/backend seed",
    "media:test-images": "pnpm --filter @sugar-store/media-pipeline create-test-images",
    "media:process": "pnpm --filter @sugar-store/media-pipeline process",
    "media:pipeline": "pnpm --filter @sugar-store/media-pipeline pipeline",
    "redirects:sample": "pnpm --filter @sugar-store/shopify-redirects create-sample",
    "redirects:build": "pnpm --filter @sugar-store/shopify-redirects build-map"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^19.0.0",
      "@types/react-dom": "^19.0.0"
    },
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "@medusajs/telemetry",
      "msgpackr-extract",
      "protobufjs",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.0",
    "turbo": "^2.3.0",
    "typescript": "^5.5.0"
  }
}
