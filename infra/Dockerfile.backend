# syntax=docker/dockerfile:1
# Production image for the Medusa backend.
# Build from the repo root:  docker build -f infra/Dockerfile.backend -t sugar-backend .

# ── Builder ────────────────────────────────────────────────────────────────────
FROM node:22-bookworm-slim AS builder
WORKDIR /app

RUN corepack enable

# Install workspace deps (cached on lockfile changes).
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml .npmrc ./
COPY apps/backend/package.json apps/backend/package.json
COPY packages/config/package.json packages/config/package.json
RUN pnpm install --frozen-lockfile

# Build the backend (outputs to apps/backend/.medusa/server).
COPY . .
RUN pnpm --filter @sugar-store/backend build

# ── Runner ─────────────────────────────────────────────────────────────────────
FROM node:22-bookworm-slim AS runner
WORKDIR /app/server
ENV NODE_ENV=production

RUN corepack enable

# The compiled server is self-contained under .medusa/server.
COPY --from=builder /app/apps/backend/.medusa/server ./
RUN pnpm install --prod --frozen-lockfile=false

EXPOSE 9000

# Run migrations then start (override in compose if you prefer a separate step).
CMD ["sh", "-c", "npx medusa db:migrate && npx medusa start"]
