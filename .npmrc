# Required for Medusa v2 in pnpm monorepos — its internal modules need
# transitive deps (react, @medusajs/dashboard, etc.) to be accessible at runtime.
shamefully-hoist=true

# Hoist shared tooling so all workspace packages can resolve them
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=typescript
public-hoist-pattern[]=@typescript-eslint*
